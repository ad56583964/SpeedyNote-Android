# Conan 2 host profile for Android arm64-v8a (NDK 25.2)
[settings]
os=Android
os.api_level=23
arch=armv8
compiler=clang
compiler.version=14
compiler.libcxx=c++_shared
compiler.cppstd=17
build_type=Debug

[conf]
# Point Conan toolchain to the preinstalled NDK in base image
tools.android:ndk_path=/opt/android-sdk/ndk/25.2.9519653
# Use Ninja and keep generator consistent
tools.cmake.cmaketoolchain:generator=Ninja
